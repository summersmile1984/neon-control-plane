# Control plane (002 §11). Copy to .env and fill CP_MASTER_KEY.
CP_PORT=8080
CP_DB_PATH=./data/cp.sqlite

# 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CP_MASTER_KEY=

# Storage layer (matches infra/compose/docker-compose.yml)
CP_PAGESERVER_URL=http://127.0.0.1:9898
CP_PAGESERVER_CONNSTRING="host=pageserver port=6400"
CP_SAFEKEEPERS=safekeeper1:5454

# Images: storage and compute must come from the same CI build (002 §14 item 5)
CP_NEON_TAG=latest
CP_COMPUTE_IMAGE_REPO=docker.io/neondatabase

# Compute containers
CP_DOCKER_SOCKET=/var/run/docker.sock
CP_DOCKER_NETWORK=neon-cp
CP_COMPUTE_VOLUME_ROOT=./data/computes
CP_PORT_RANGE=55500-55700

# Connection routing: direct | sni-router | proxy
CP_ROUTE_MODE=direct
CP_ZONE=db.siteops.localhost

# M3 only: bearer the Neon proxy presents to /cplane/*
CP_PROXY_TOKEN=

# Validate every response against the vendored OpenAPI schema (keep on outside production)
CP_VALIDATE_RESPONSES=1
