# Control plane (002 §11). Copy to .env and fill CP_MASTER_KEY.
CP_PORT=8080
CP_DB_PATH=./data/cp.sqlite
# Stable ownership identity for THIS SQLite ledger and its compute containers.
# Use a different identity with each isolated test ledger. Unset disables orphan reclaim.
CP_INSTANCE_ID=neon-cp-local

# 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CP_MASTER_KEY=

# Storage layer (matches infra/compose/docker-compose.yml)
CP_PAGESERVER_URL=http://127.0.0.1:9898
CP_PAGESERVER_CONNSTRING="host=pageserver port=6400"
CP_SAFEKEEPERS=safekeeper1:5454
# Compose publishes the object storage API/console on host 19000/19001 by default.
# Override NEON_MINIO_API_PORT/NEON_MINIO_CONSOLE_PORT in infra/compose/.env;
# internal storage always connects to minio:9000 (rustfs serves that service name).

# Images: storage and compute must come from the same CI build (002 §14 item 5)
CP_NEON_TAG=latest
CP_COMPUTE_IMAGE_REPO=docker.io/neondatabase

# Compute containers
CP_DOCKER_SOCKET=/var/run/docker.sock
CP_DOCKER_NETWORK=neon-cp
CP_COMPUTE_VOLUME_ROOT=./data/computes
CP_PORT_RANGE=55500-55700

# Connection routing: direct | sni-router | proxy
CP_ROUTE_MODE=direct
CP_ZONE=db.neon.localhost

# M3 only: bearer the Neon proxy presents to /cplane/*
CP_PROXY_TOKEN=

# Validate every response against the vendored OpenAPI schema (keep on outside production)
CP_VALIDATE_RESPONSES=1

# --- Identity and API keys (design 004) ---
# The control plane always requires auth. First start seeds this owner + organization and, when
# CP_BOOTSTRAP_API_KEY is set, a personal key for the owner so a client can log in immediately.
CP_ORG_ID=org-super-glade-55833945
CP_ORG_NAME=Local Organization
CP_OWNER_ID=00000000-0000-0000-0000-000000000001
CP_OWNER_EMAIL=owner@neon.localhost
CP_OWNER_NAME=Local Owner
CP_OWNER_LAST_NAME=
# Optional: enables console password login; empty means password login is off.
CP_OWNER_PASSWORD=
# Optional: mint this exact token as the owner's first personal key (plaintext; store nowhere else).
CP_BOOTSTRAP_API_KEY=
CP_KEY_PREFIX=napi_
CP_SESSION_TTL_SECONDS=2592000
# Dev-only one-click console login. Never enable outside a local environment.
CP_DEV_LOGIN=0

# Optional generic OIDC console login. Set CP_OIDC_ISSUER to enable.
# CP_OIDC_ISSUER=https://accounts.example.com
# CP_OIDC_CLIENT_ID=neon-control-plane
# CP_OIDC_CLIENT_SECRET=
# CP_OIDC_REDIRECT_URI=http://localhost:8080/console/oidc/callback
# CP_OIDC_SCOPES=openid email profile
