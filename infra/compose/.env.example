# Pin storage and compute to the same CI build. Docker Hub publishes numeric tags shared by
# `neon` and `compute-node-v*` (e.g. 8464); `latest` is fine until T-901 pins a number.
NEON_REPOSITORY=docker.io/neondatabase
NEON_TAG=latest
PG_VERSION=17

# Host-only MinIO ports; containers keep using minio:9000 and minio:9001.
NEON_MINIO_API_PORT=19000
NEON_MINIO_CONSOLE_PORT=19001

# Release of quay.io/minio/minio used for the one-shot bucket-creation job. It only supplies the
# `mc` binary, so any release that still bundles it works; the standalone minio/mc client is no
# longer pullable from Docker Hub.
MINIO_CLIENT_TAG=RELEASE.2025-04-22T22-12-26Z

# Shared with the control plane CP_PROXY_TOKEN; the proxy presents it on /cplane/*.
CP_PROXY_TOKEN=local-proxy-token
CP_PORT=8080
